# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=books

# ---- Anthropic ----
ANTHROPIC_API_KEY=sk-ant-...
# Claude 3.5 Sonnet is retired; use a current model id.
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- ML ingestion service (Hugging Face ZeroGPU Space, Gradio API) ----
ML_SERVICE_URL=https://your-username-bookmentor-ml.hf.space
# Shared HMAC secret (>= 32 chars). Must match ML_SHARED_SECRET in the Space secrets.
ML_SHARED_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
# Optional Hugging Face token: required for a private Space, and bills ZeroGPU time to your
# account instead of the anonymous per-IP quota. Leave empty for a public Space.
ML_SERVICE_TOKEN=

# ---- App ----
APP_BASE_URL=https://your-app.vercel.app
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=replace-with-a-random-string

# ---- Free-tier guardrails ----
MAX_USER_STORAGE_MB=200
MAX_USER_DB_MB=50
ORPHAN_MAX_AGE_HOURS=24
